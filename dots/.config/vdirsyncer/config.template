# TEMPLATE -- safe to commit. Copy to `config` and fill in the placeholders.
#
# The real `config` is gitignored because it holds three bearer credentials:
#   - client_id / client_secret for the OAuth app
#   - the secret iCal URL, which grants unauthenticated read access to the
#     whole work calendar to anyone who has it
#
# Setup instructions: README-google.md

[general]
status_path = "~/.local/share/vdirsyncer/status/"

# ---------------------------------------------------------------------------
# Google Calendar (all calendars on the account)
#
# client_id / client_secret come from a Google Cloud OAuth "Desktop app"
# client. See ~/.config/vdirsyncer/README-google.md for the setup steps.
# ---------------------------------------------------------------------------

[pair google_calendar]
a = "gcal_local"
b = "gcal_remote"

# "from b" = discover every calendar on the Google account, including the ones
# other people shared with you. To sync only a subset, replace this with an
# explicit list of collection ids, e.g.
#   collections = ["primary", "abc123@group.calendar.google.com"]
collections = ["from b"]

# Pull the calendar's display name and colour into the local vdir so khal (and
# therefore the sidebar) can label and colour-code each one.
metadata = ["displayname", "color"]

conflict_resolution = "b wins"

[storage gcal_local]
type = "filesystem"
path = "~/.local/share/vdirsyncer/calendars/"
fileext = ".ics"

[storage gcal_remote]
type = "google_calendar"
token_file = "~/.local/share/vdirsyncer/google_token"

# Safety: the sidebar only ever reads events, so nothing is ever pushed back to
# Google. Set this to false if you later want local edits to sync upward.
read_only = true

client_id = "YOUR_CLIENT_ID_HERE.apps.googleusercontent.com"
client_secret = "YOUR_CLIENT_SECRET_HERE"

# ---------------------------------------------------------------------------
# iCal feed: work
# Google's CalDAV endpoint does not expose calendars shared from another
# account, so this one is pulled from its iCal URL instead. Read-only.
# collections = null because an iCal feed is a single calendar, not a
# discoverable set.
# ---------------------------------------------------------------------------

[pair work_ical]
a = "work_ical_local"
b = "work_ical_remote"
collections = null
conflict_resolution = "b wins"

[storage work_ical_local]
type = "filesystem"
path = "~/.local/share/vdirsyncer/calendars-work-ical/work/"
fileext = ".ics"

[storage work_ical_remote]
type = "http"
url = "https://calendar.google.com/calendar/ical/<CALENDAR_ID>/private-<SECRET_HASH>/basic.ics"
